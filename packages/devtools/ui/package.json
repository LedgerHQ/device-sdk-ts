{
  "name": "@ledgerhq/device-management-kit-devtools-ui",
  "private": false,
  "version": "1.1.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/LedgerHQ/device-sdk-ts.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js"
    },
    "./tailwind.css": "./tailwind.css",
    "./*": {
      "types": "./lib/types/*",
      "import": "./lib/esm/*",
      "require": "./lib/cjs/*"
    }
  },
  "files": [
    "./lib",
    "./tailwind.css"
  ],
  "scripts": {
    "prebuild": "rimraf lib",
    "build": "pnpm ldmk-tool build --entryPoints index.ts,src/*.tsx,src/*.ts,src/**/*.tsx,src/**/*.ts --tsconfig tsconfig.build.json",
    "dev": "concurrently \"pnpm watch:builds\" \"pnpm watch:types\"",
    "watch:builds": "pnpm ldmk-tool watch --entryPoints index.ts,src/*.tsx,src/*.ts,src/**/*.tsx,src/**/*.ts --tsconfig tsconfig.build.json",
    "watch:types": "concurrently \"tsc --watch -p tsconfig.prod.json\" \"tsc-alias --watch -p tsconfig.prod.json\"",
    "lint": "eslint",
    "lint:fix": "pnpm lint --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate:apdu-commands": "tsx scripts/generate-apdu-commands.ts"
  },
  "dependencies": {
    "@ledgerhq/device-mockserver-react": "workspace:^",
    "@ledgerhq/lumen-design-core": "0.1.34",
    "@ledgerhq/lumen-ui-react": "0.1.66",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tooltip": "1.2.8",
    "class-variance-authority": "0.7.1",
    "react-resizable-panels": "^4.4.1",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@ledgerhq/device-management-kit": "workspace:^",
    "@ledgerhq/device-management-kit-devtools-core": "workspace:^",
    "@ledgerhq/eslint-config-dsdk": "workspace:^",
    "@ledgerhq/ldmk-tool": "workspace:^",
    "@ledgerhq/prettier-config-dsdk": "workspace:^",
    "@ledgerhq/tsconfig-dsdk": "workspace:^",
    "@ledgerhq/vitest-config-dmk": "workspace:^",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@ledgerhq/device-management-kit": "workspace:^",
    "@ledgerhq/device-management-kit-devtools-core": "workspace:^",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
