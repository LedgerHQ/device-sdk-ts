{
  "name": "@ledgerhq/ldmk-tool",
  "license": "Apache-2.0",
  "version": "0.0.1",
  "private": true,
  "description": "A collection of scripts and utilities for Ledger Device Management Kit monorepo",
  "bin": {
    "ldmk-tool": "./cli.cjs"
  },
  "exports": {
    "./guardrails": "./guardrails/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "*.cjs",
    "guardrails/**/*.mjs",
    "!guardrails/**/*.test.mjs",
    "!.prettierrc.cjs"
  ],
  "scripts": {
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@inquirer/prompts": "catalog:",
    "dependency-cruiser": "catalog:"
  },
  "devDependencies": {
    "@ledgerhq/eslint-config-dsdk": "workspace:^",
    "@ledgerhq/prettier-config-dsdk": "workspace:^",
    "esbuild": "catalog:",
    "esbuild-node-externals": "catalog:",
    "vitest": "catalog:"
  }
}
