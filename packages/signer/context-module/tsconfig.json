{
  "extends": "@ledgerhq/tsconfig-dsdk/tsconfig.sdk",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./lib/types",
    "module": "ES2022",
    "target": "es2022",
    "moduleResolution": "bundler",
    "emitDeclarationOnly": true,
    "paths": {
      "@/*": ["src/*"],
      "@root/*": ["./*"]
    },
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["index.ts", "src", "vitest.*.mjs"]
}
