      "description": "Lens post: strings and integers shown with no formatting",
      "data": {
        "domain": {
          "name": "LensHub",
          "version": "2",
          "chainId": 137,
          "verifyingContract": "0xdb46d1dc155634fbc732f92e853b10b288ad5a1d"
        },
        "primaryType": "Post",
        "types": {
          "EIP712Domain": [
            {
              "name": "name",
              "type": "string"
            },
            {
              "name": "version",
              "type": "string"
            },
            {
              "name": "chainId",
              "type": "uint256"
            },
            {
              "name": "verifyingContract",
              "type": "address"
            }
          ],
          "Post": [
            {
              "name": "profileId",
              "type": "uint256"
            },
            {
              "name": "contentURI",
              "type": "string"
            },
            {
              "name": "actionModules",
              "type": "address[]"
            },
            {
              "name": "actionModulesInitDatas",
              "type": "bytes[]"
            },
            {
              "name": "referenceModule",
              "type": "address"
            },
            {
              "name": "referenceModuleInitData",
              "type": "bytes"
            },
            {
              "name": "nonce",
              "type": "uint256"
            },
            {
              "name": "deadline",
              "type": "uint256"
            }
          ]
        },
        "message": {
          "profileId": "42",
          "contentURI": "ipfs://QmTzQ1Nj5CFbGXUBuoZvEphAE1rKMQR7FxGZFkJu3QLNSG",
          "actionModules": [],
          "actionModulesInitDatas": [],
          "referenceModule": "0x0000000000000000000000000000000000000000",
          "referenceModuleInitData": "0x",
          "nonce": 5,
          "deadline": 1735689600
        }
      },
      "expectedTexts": [
        "Review typed message to Post",
        "Interaction with LensHub",
        "Profile Id 42",
        "nonce 5",
        "Network Polygon"
      ]
    },
