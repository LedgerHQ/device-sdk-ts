{
  "name": "@ledgerhq/clear-signing-tester",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript tool for testing clear-signing transactions using Ledger Device Management Kit",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js"
    }
  },
  "scripts": {
    "cli": "tsx src/cli/index.ts",
    "build": "tsc",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:scenarios": "pnpm cli test"
  },
  "dependencies": {
    "@ledgerhq/cal-interceptor": "workspace:^",
    "@ledgerhq/context-module": "workspace:^",
    "@ledgerhq/device-contacts-kit": "workspace:^",
    "@ledgerhq/device-management-kit": "workspace:^",
    "@ledgerhq/device-signer-kit-ethereum": "workspace:^",
    "@ledgerhq/device-signer-kit-solana": "workspace:^",
    "@ledgerhq/solana-tools": "workspace:^",
    "@ledgerhq/device-transport-kit-speculos": "workspace:^",
    "@ledgerhq/speculos-device-controller": "workspace:^",
    "commander": "catalog:",
    "ethers": "catalog:",
    "inversify": "catalog:",
    "rxjs": "catalog:",
    "semver": "catalog:",
    "undici": "^8.8.0"
  },
  "devDependencies": {
    "@ledgerhq/vitest-config-dmk": "workspace:^",
    "@ledgerhq/eslint-config-dsdk": "workspace:^",
    "@ledgerhq/prettier-config-dsdk": "workspace:^",
    "@ledgerhq/tsconfig-dsdk": "workspace:^",
    "@types/semver": "catalog:",
    "concurrently": "catalog:",
    "ts-node": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
